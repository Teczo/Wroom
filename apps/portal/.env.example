# Copy to .env. Vite exposes anything prefixed VITE_ to the browser —
# never put a secret in here. These are all public client identifiers.

VITE_API_BASE_URL=http://localhost:4000

# Auth0 SPA application. The audience must match the API's AUTH0_AUDIENCE.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
