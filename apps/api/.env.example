# Copy to .env and fill in from the deployment environment.
# Never commit .env. Never put a real value in this file.

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string, including the database name.
MONGODB_URI=

# Auth0 — protects every /api/* route. The portfolio's /public/* routes are open.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# Azure Blob Storage — media uploads. Never exposed to a client.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=

# Comma-separated list of allowed browser origins, e.g. the portal and portfolio URLs.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Stripe — read-only. The revenue sync reads invoices with this at the moment it
# runs. `vendorConnections.secretRef` records where this key lives (e.g.
# kv://teczo/stripe); the value itself only ever exists here.
STRIPE_SECRET_KEY=

# Reserved for features not built yet — leave blank until the ticket that needs them.
GITHUB_APP_TOKEN=
ANTHROPIC_API_KEY=
