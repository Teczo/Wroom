{
  "name": "@wroom/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "seed": "tsx src/jobs/seed.ts",
    "ensure-indexes": "tsx src/jobs/ensureIndexes.ts"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.26.0",
    "@wroom/shared": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.0.1",
    "express-oauth2-jwt-bearer": "^1.6.1",
    "mongoose": "^8.8.0",
    "papaparse": "^5.6.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "@types/papaparse": "^5.5.2",
    "tsx": "^4.19.2"
  }
}
