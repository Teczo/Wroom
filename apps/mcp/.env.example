# The MCP server. Claude.ai connects to this from Anthropic's cloud, so it has
# to be reachable over the public internet — localhost will not work.
# docs/ENV_SETUP.md covers obtaining these.

NODE_ENV=development
PORT=4100

# Auth0 tenant. The same one the API uses — it is the authorization server for
# both legs, issuing tokens for two different audiences.
AUTH0_DOMAIN=

# --- leg one: Claude -> this server -----------------------------------------
# This server's own Auth0 API identifier. Must be an absolute URI (RFC 8707 and
# the MCP spec both require it), and it is the audience an incoming token has to
# carry. Also the public URL Claude connects to.
MCP_SERVER_IDENTIFIER=

# --- leg two: this server -> the Wroom API ----------------------------------
# A separate credential. The token Claude presents is bound to this server and
# is never forwarded — the MCP spec forbids it and the API would reject it.
WROOM_API_URL=
# The Wroom API's Auth0 audience — the same value as the API's AUTH0_AUDIENCE.
AUTH0_AUDIENCE=
# Machine-to-machine application, authorised for the audience above.
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
