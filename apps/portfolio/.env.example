# Copy to .env. The portfolio is unauthenticated — it only ever calls /public/*,
# which reads the published snapshot. There is no key of any kind here.

VITE_API_BASE_URL=http://localhost:4000

# Read by the Vercel edge function in middleware.ts, not by the app bundle, and
# set in Vercel's environment rather than here — it is the same public API, from
# the edge instead of the browser. Unset, the edge function does nothing and
# every page keeps the default meta tags from index.html.
PUBLIC_API_URL=http://localhost:4000
